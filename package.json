{
  "name": "precise-reading-edit",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --platform=browser --target=es2020 --format=cjs --external:obsidian --outfile=main.js",
    "test": "esbuild test/resolve-position.test.ts test/reading-dom.test.ts --bundle --platform=node --format=cjs --out-extension:.js=.cjs --outdir=.test && node --test .test/*.test.cjs"
  },
  "devDependencies": {
    "esbuild": "0.25.5",
    "obsidian": "1.10.3",
    "typescript": "5.8.3"
  }
}
